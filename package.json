{
  "name": "customer-value-health",
  "version": "0.0.1",
  "description": "ONES 客户价值与应用健康度报告 Hosted App",
  "author": "",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "predev": "npx -y install-now",
    "dev": "NODE_ENV=development concurrently -n backend,web \"npm run dev:backend\" \"npm run dev:web\"",
    "dev:backend": "nest start --watch --preserveWatchOutput",
    "dev:web": "vite",
    "prebuild": "NODE_ENV=development npx -y install-now",
    "build": "npm run build:backend && npm run build:web",
    "build:backend": "nest build && ncc build dist/main.js -o dist/backend",
    "build:web": "vite build",
    "prepare": "npx husky"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/serve-static": "^5.0.4",
    "@ones-design/core": "^2.37.2",
    "@ones-design/icons": "^2.60.0",
    "@ones-design/locale": "^1.18.0",
    "@ones-design/table": "^1.7.2",
    "@ones-design/theme": "^0.5.1",
    "@ones-open/node-sdk": "0.0.19",
    "@ones-open/web-sdk": "0.0.19",
    "fs-extra": "^11.3.0",
    "glob": "^13.0.2",
    "lodash-es": "^4.17.23",
    "react": "~17.0.2",
    "react-dom": "~17.0.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.1",
    "vite-plugin-css-injected-by-js": "^3.5.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@ones-open/cli": "^0.0.19",
    "@types/express": "^5.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.7",
    "@types/react": "~17.0.91",
    "@types/react-dom": "~17.0.26",
    "@types/react-virtualized-auto-sizer": "1.0.4",
    "@vercel/ncc": "^0.38.4",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "postcss-preset-env": "^11.2.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.2.2"
  },
  "browserslist": [
    "Chrome >= 79",
    "Edge >= 79",
    "Firefox >= 87",
    "Safari >= 14"
  ],
  "lint-staged": {
    "backend/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "install-now": [
    "npm"
  ]
}
