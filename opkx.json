{
  "app": {
    "id": "app_09b374c462ec4d64",
    "name": "customer-value-health",
    "version": "v0.0.1",
    "desc": "ONES 客户价值与应用健康度报告：按周期生成不可变报告快照，产出客户价值报告、应用健康度报告、增购机会建议和客户版 PDF。",
    "logo": "/public/logo.svg",
    "auth": {
      "type": "jwt"
    },
    "lifecycle_callback": {
      "install": "/install_cb",
      "enabled": "/enabled_cb",
      "disabled": "/disabled_cb",
      "uninstalled": "/uninstalled_cb"
    },
    "oauth": {
      "scope": [
        "read:account:teams",
        "read:account:user",
        "read:project:project",
        "read:project:sprint",
        "read:project:issue",
        "read:project:issueField",
        "read:project:issue-comment",
        "read:project:issue-timeSpent",
        "read:project:workLog-timeEstimated",
        "read:wiki:space",
        "read:wiki:page",
        "read:testcase:library",
        "read:license:app"
      ],
      "type": [
        "app",
        "user"
      ]
    },
    "extensions": {
      "appSettingPages": [
        {
          "key": "entries",
          "funcs": {
            "customEntries": "/app_setting_entries"
          }
        }
      ]
    }
  },
  "ones": {
    "storage": {
      "entities": [
        {
          "name": "installation_info",
          "attributes": {
            "installation_id": {
              "type": "string",
              "length": 128,
              "required": true
            },
            "shared_secret": {
              "type": "string",
              "length": 512,
              "required": true
            },
            "ones_base_url": {
              "type": "string",
              "length": 256,
              "required": true
            },
            "status": {
              "type": "string",
              "length": 32,
              "required": true
            },
            "time_stamp": {
              "type": "integer",
              "required": true
            },
            "updated_at": {
              "type": "integer",
              "required": true
            }
          },
          "indexes": [
            {
              "name": "idx_installation_updated",
              "range_attribute": "updated_at"
            }
          ]
        },
        {
          "name": "report_job",
          "attributes": {
            "job_id": {
              "type": "string",
              "length": 36,
              "required": true
            },
            "team_uuid": {
              "type": "string",
              "length": 32,
              "required": true
            },
            "period_start": {
              "type": "integer",
              "required": true
            },
            "period_end": {
              "type": "integer",
              "required": true
            },
            "compare_start": {
              "type": "integer",
              "required": true
            },
            "compare_end": {
              "type": "integer",
              "required": true
            },
            "rule_version": {
              "type": "string",
              "length": 32,
              "required": true
            },
            "status": {
              "type": "string",
              "length": 16,
              "required": true
            },
            "stage": {
              "type": "string",
              "length": 32,
              "required": true
            },
            "progress": {
              "type": "integer",
              "required": true
            },
            "error": {
              "type": "string",
              "length": 512,
              "required": true
            },
            "snapshot_key": {
              "type": "string",
              "length": 36,
              "required": true
            },
            "requested_by": {
              "type": "string",
              "length": 32,
              "required": true
            },
            "created_at": {
              "type": "integer",
              "required": true
            },
            "updated_at": {
              "type": "integer",
              "required": true
            }
          },
          "indexes": [
            {
              "name": "idx_job_team_created",
              "range_attribute": "created_at",
              "partition": [
                "team_uuid"
              ]
            },
            {
              "name": "idx_job_status",
              "range_attribute": "created_at",
              "partition": [
                "status"
              ]
            }
          ]
        },
        {
          "name": "report_snapshot",
          "attributes": {
            "snapshot_id": {
              "type": "string",
              "length": 64,
              "required": true
            },
            "job_id": {
              "type": "string",
              "length": 64,
              "required": true
            },
            "team_uuid": {
              "type": "string",
              "length": 64,
              "required": true
            },
            "period_start": {
              "type": "integer",
              "required": true
            },
            "period_end": {
              "type": "integer",
              "required": true
            },
            "rule_version": {
              "type": "string",
              "length": 64,
              "required": true
            },
            "metrics_json": {
              "type": "text",
              "required": true
            },
            "narrative_json": {
              "type": "text",
              "required": true
            },
            "coverage": {
              "type": "integer",
              "required": true
            },
            "created_at": {
              "type": "integer",
              "required": true
            }
          },
          "indexes": [
            {
              "name": "idx_snapshot_team_created",
              "range_attribute": "created_at",
              "partition": [
                "team_uuid"
              ]
            }
          ]
        },
        {
          "name": "narrative_revision",
          "attributes": {
            "revision_id": {
              "type": "string",
              "length": 64,
              "required": true
            },
            "snapshot_id": {
              "type": "string",
              "length": 64,
              "required": true
            },
            "editor_uuid": {
              "type": "string",
              "length": 64,
              "required": true
            },
            "narrative_json": {
              "type": "text",
              "required": true
            },
            "created_at": {
              "type": "integer",
              "required": true
            }
          },
          "indexes": [
            {
              "name": "idx_revision_snapshot_created",
              "range_attribute": "created_at",
              "partition": [
                "snapshot_id"
              ]
            }
          ]
        },
        {
          "name": "audit_log",
          "attributes": {
            "log_id": {
              "type": "string",
              "length": 64,
              "required": true
            },
            "team_uuid": {
              "type": "string",
              "length": 64,
              "required": true
            },
            "actor_uuid": {
              "type": "string",
              "length": 64,
              "required": true
            },
            "action": {
              "type": "string",
              "length": 64,
              "required": true
            },
            "target_type": {
              "type": "string",
              "length": 32,
              "required": true
            },
            "target_id": {
              "type": "string",
              "length": 64,
              "required": true
            },
            "detail_json": {
              "type": "text",
              "required": true
            },
            "created_at": {
              "type": "integer",
              "required": true
            }
          },
          "indexes": [
            {
              "name": "idx_audit_team_created",
              "range_attribute": "created_at",
              "partition": [
                "team_uuid"
              ]
            },
            {
              "name": "idx_audit_target",
              "range_attribute": "created_at",
              "partition": [
                "target_id"
              ]
            }
          ]
        },
        {
          "name": "export_record",
          "attributes": {
            "export_id": {
              "type": "string",
              "length": 36,
              "required": true
            },
            "snapshot_id": {
              "type": "string",
              "length": 36,
              "required": true
            },
            "team_uuid": {
              "type": "string",
              "length": 32,
              "required": true
            },
            "requested_by": {
              "type": "string",
              "length": 32,
              "required": true
            },
            "sections_json": {
              "type": "string",
              "length": 128,
              "required": true
            },
            "object_key": {
              "type": "string",
              "length": 128,
              "required": true
            },
            "created_at": {
              "type": "integer",
              "required": true
            }
          },
          "indexes": [
            {
              "name": "idx_export_snapshot",
              "range_attribute": "created_at",
              "partition": [
                "snapshot_id"
              ]
            }
          ]
        }
      ],
      "object": true
    }
  },
  "runtime": {
    "type": "ones-node-22",
    "healthcheck": {
      "path": "/health_check"
    },
    "command": [
      "node",
      "dist/backend/index.js"
    ]
  }
}
