{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Auth Login Info Request",
  "type": "object",
  "properties": {
    "org_uuid": {
      "type": "string",
      "description": "ONES organization UUID"
    },
    "auth_info": {
      "type": "string",
      "description": "Opaque auth payload from your auth implementation, which you will use to get user profile in your system"
    }
  },
  "required": ["org_uuid", "auth_info"],
  "additionalProperties": false
}
